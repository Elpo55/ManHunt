# Copier en apps/mobile/.env (développement). Pour les builds EAS, définir ces
# valeurs dans expo.dev > projet > Environment variables (visibilité « Plain text »).
# Toutes ces valeurs sont PUBLIQUES (protégées par la RLS). Jamais de clé service_role.

# Supabase > Project Settings > Data API > Project URL
EXPO_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
# Supabase > Project Settings > API Keys > anon public (ou publishable key)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Nom provisoire affiché
EXPO_PUBLIC_APP_NAME=Manhunt

# Identifiant unique de l'application (Android package / iOS bundle id), ex. com.votrenom.traque
APP_BUNDLE_ID=com.example.projettraque

# Cartographie (optionnel) : openfreemap (défaut, sans clé) | maptiler | custom
EXPO_PUBLIC_MAP_PROVIDER=openfreemap
EXPO_PUBLIC_MAPTILER_KEY=
EXPO_PUBLIC_MAP_TILES_URL=
EXPO_PUBLIC_MAP_STYLE_URL=
# Géocodage (recherche de zone) : défaut Nominatim public (1 requête/s)
EXPO_PUBLIC_GEOCODER_URL=
