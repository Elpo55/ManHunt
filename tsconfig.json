{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "paths": { "@shared": ["./packages/shared/src/index.ts"], "@shared/*": ["./packages/shared/src/*"] }
  },
  "include": ["tests/**/*.ts", "vitest.config.mts"]
}
