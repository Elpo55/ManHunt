{
  "name": "projet-traque",
  "version": "0.5.0",
  "private": true,
  "description": "Jeu de traque géolocalisé multijoueur (Android / iOS) — monorepo.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run tests/db",
    "test:load": "node scripts/load-test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/shared/tsconfig.json && npm run typecheck -w apps/mobile",
    "lint": "npm run lint -w apps/mobile",
    "mobile": "npm run start -w apps/mobile",
    "icons": "node scripts/generate-icons.mjs",
    "release:apk": "node scripts/release-apk.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
