# Copier ce fichier en .env.local (développement) et renseigner les valeurs.
# En production, définir ces variables dans Cloudflare Pages > Settings > Variables and Secrets.
# Ces deux valeurs sont PUBLIQUES par conception (protégées par la RLS).
# NE JAMAIS mettre la clé service_role / secret key ici.

# Supabase > Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
# Supabase > Project Settings > API Keys > "anon public" (ou "publishable key" sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nom provisoire affiché dans l'application (modifiable à tout moment).
NEXT_PUBLIC_APP_NAME=Projet Traque
